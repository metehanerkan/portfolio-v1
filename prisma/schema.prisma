generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. PROJELER TABLOSU (Portfolio Kısmı)
model Project {
  id           String   @id @default(cuid())
  title        String
  description  String
  technologies String[]
  githubUrl    String?
  liveUrl      String?
  imageUrl     String
  category     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isPublished  Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  viewCount    Int      @default(0)
}

// 2. BLOG YAZILARI TABLOSU
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String
  imageUrl    String
  category    String
  readTime    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
}

// 3. İLETİŞİM MESAJLARI
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("Genel Başvuru")
  message   String   @db.Text // Uzun mesajlar kesilmesin diye Text yaptık
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

// 4. MÜŞTERİ PROJELERİ (Yönetim Paneli Kısmı)
model ClientProject {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Temel Bilgiler
  name        String   // Müşteri Adı
  email       String   // Müşteri E-postası
  accessCode  String   @unique // Giriş Kodu
  description String   @db.Text // Tüm detaylı başvuru formu buraya kaydedilir
  status      ProjectStatus @default(BRIEF_SUBMITTED)
  budget      String?  // Admin'in verdiği fiyat
  deadline    String?  // Admin'in verdiği tarih
  adminNotes  String?  @db.Text // Admin'in kapsam notları
  clientOfferPrice    String?  // Müşterinin istediği fiyat
  clientOfferDeadline String?  // Müşterinin istediği süre
  clientOfferNotes    String?  @db.Text // Müşterinin revize notları (Platform, Özellikler vb.)
  progress     Int     @default(0) // Yüzde kaç bitti? (0-100)
  currentStage String? @default("Hazırlık") // Şu an ne yapılıyor?
  features     String? 
  notes        String? 
  startDate    DateTime @default(now())
  timeline     Json?    // 👈 YENİ: Proje takvimi (Gantt verisi)
  requests ProjectRequest[] // 👈 YENİ: Talepleri projeye bağladık
}

// 5. PROJE DURUMLARI (Kod içinde kullandığımız statüler)
enum ProjectStatus {
  WAITING_BRIEF   // Beklemede
  BRIEF_SUBMITTED // İnceleniyor (İlk Başvuru)
  PRICING_SENT    // Teklif Gönderildi
  NEGOTIATION     // Pazarlık / Revize Aşamasında
  APPROVED        // Onaylandı / Canlı Yayında
  COMPLETED       // Tamamlandı
  CANCELLED       // İptal Edildi
}

model ProjectRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   // 'new_feature', 'change', 'cancel', 'bug'
  message   String   @db.Text
  status    String   @default("PENDING") // PENDING (Bekliyor), APPROVED (Onaylandı), REJECTED (Red)
  attachmentUrl String?
}


model SiteSettings {
  id              String  @id @default(uuid())
  maintenanceMode Boolean @default(false) // Varsayılan: Kapalı
  
  // Genel Ayarlar
  siteTitle       String? @default("Metehan Erkan Portfolio")
  siteDesc        String? @default("Full Stack Developer Portfolyosu")
  footerText      String? @default("Modern web teknolojileri ile ölçeklenebilir çözümler.")
  
  // Profil
  aboutTitle      String? @default("Kod Yazmak Benim İçin Bir Tutku.") // Hakkımda sayfasındaki büyük başlık
  aboutText       String? @db.Text // Hakkımda yazısı (Markdown)
  cvUrl           String? // CV PDF dosya yolu
  
  // İstatistikler (Hakkımda Sayfası)
  statProjects    String? @default("5+")
  statYears       String? @default("1+")
  statLearnings   String? @default("∞")
  
  // Görünüm & Yetenekler
  primaryColor    String? @default("#3b82f6") // Varsayılan Mavi
  skills          String? @db.Text // JSON string olarak tutacağız: [{name: 'React', icon: 'FaReact'}, ...]
  
  // İletişim
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?
  
  // Sosyal Medya
  socialGithub    String?
  socialLinkedin  String?
  socialTwitter   String?
  socialInstagram String?
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "INFO", "ERROR", "WARNING", "SUCCESS"
  message   String   // "İletişim formu gönderildi" veya "DB Bağlantı hatası"
  source    String?  // Hatayı tetikleyen yer. Örn: "/contact" veya "API"
  createdAt DateTime @default(now())
}

// 6. E-BÜLTEN ABONELİKLERİ
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 7. ZİYARETÇİ LOGLARI (TRAFİK ANALİZİ)
model VisitLog {
  id        String   @id @default(cuid())
  ipHash    String   // KVKK uyumu için hashlenmiş IP
  userAgent String?
  browser   String?
  os        String?
  device    String?  // Mobile, Desktop, Tablet
  path      String   // Hangi sayfa?
  country   String?  // (Opsiyonel) Ülke
  city      String?  // (Opsiyonel) Şehir
  createdAt DateTime @default(now())
}

// 8. SİSTEM METRİKLERİ
model SystemMetric {
  id        String   @id @default(cuid())
  dbLatency Int
  apiLatency Int
  createdAt DateTime @default(now())
}